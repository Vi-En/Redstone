{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Redstone",
  "version": "0.1.0",
  "identifier": "com.redstone.app",
  "build": {
    "beforeDevCommand": "npm --prefix ../ui install && npm --prefix ../ui run dev -- --host",
    "beforeBuildCommand": "npm --prefix ../ui install && npm --prefix ../ui run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Redstone",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Game",
    "shortDescription": "Open-source Minecraft server host app",
    "longDescription": "Open-source Minecraft server host app running fully on your device: no cloud, no account, no telemetry."
  }
}
